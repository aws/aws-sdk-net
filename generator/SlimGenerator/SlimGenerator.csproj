<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SlimGenerator</RootNamespace>
    <AssemblyName>slim-generator</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>slim-generator</ToolCommandName>
    <PackageId>SlimGenerator</PackageId>
    <Version>1.3.0</Version>
    <IsPackable>true</IsPackable>
    <Description>CLI tool to generate an AWS service client DLL from service model files.</Description>
	<PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ServiceClientGeneratorLib/ServiceClientGeneratorLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../sdk/src/Core/sdk-default-configuration.json" LogicalName="SlimGenerator.sdk-default-configuration.json" />
    <PackageReference Include="NuGet.Versioning" Version="6.8.0" />
  </ItemGroup>
</Project>
