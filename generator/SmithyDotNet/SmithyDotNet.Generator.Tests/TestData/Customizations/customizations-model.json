{
  "smithy": "2.0",
  "shapes": {
    "com.example#Service": {
      "type": "service",
      "version": "2023-01-01",
      "rename": { "com.example#Moved": "MovedAway" },
      "operations": [{ "target": "com.example#ListBuckets" }],
      "resources": [{ "target": "com.example#BucketResource" }]
    },
    "com.example#BucketResource": {
      "type": "resource",
      "operations": [{ "target": "com.example#TagBucket" }],
      "collectionOperations": [{ "target": "com.example#DeleteBucket" }]
    },
    "com.example#TagBucket": {
      "type": "operation"
    },
    "com.example#ListBuckets": {
      "type": "operation",
      "output": { "target": "com.example#BucketPage" },
      "traits": { "smithy.api#paginated": { "inputToken": "nextToken", "outputToken": "nextToken", "items": "buckets" } }
    },
    "com.example#BucketPage": {
      "type": "structure",
      "members": {
        "nextToken": { "target": "smithy.api#String" },
        "buckets": { "target": "com.example#BucketList" }
      },
      "traits": { "smithy.api#output": {} }
    },
    "com.example#BucketList": {
      "type": "list",
      "member": { "target": "com.example#Bucket" }
    },
    "com.example#DeleteBucket": {
      "type": "operation"
    },
    "com.example#Orphan": {
      "type": "operation",
      "output": { "target": "com.example#Chunk" }
    },
    "com.example#OrphanWrappedOutput": {
      "type": "structure",
      "members": {}
    },
    "com.example#Bucket": {
      "type": "structure",
      "members": {
        "name": { "target": "smithy.api#String" },
        "arn": { "target": "smithy.api#String" },
        "created": { "target": "smithy.api#Timestamp", "traits": { "smithy.api#deprecated": { "since": "2020-01-01" } } }
      }
    },
    "com.example#Holder": {
      "type": "structure",
      "members": {
        "bucket": { "target": "com.example#Bucket" }
      }
    },
    "com.example#IdValue": {
      "type": "structure",
      "members": {
        "Value": { "target": "com.example#LegacyId" }
      }
    },
    "com.example#Text": {
      "type": "string"
    },
    "com.example#NameValue": {
      "type": "structure",
      "members": {
        "Value": { "target": "com.example#Text" }
      }
    },
    "com.example#NameValueMap": {
      "type": "map",
      "key": { "target": "smithy.api#String" },
      "value": { "target": "com.example#NameValue" }
    },
    "com.example#LegacyId": {
      "type": "string",
      "traits": { "smithy.api#deprecated": {} }
    },
    "com.example#StorageClass": {
      "type": "enum",
      "members": {
        "STANDARD": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "STANDARD" } }
      },
      "traits": { "smithy.api#deprecated": {} }
    },
    "com.example#Grant": {
      "type": "structure",
      "members": {}
    },
    "com.example#S3Grant": {
      "type": "structure",
      "members": {}
    },
    "com.example#Throttled": {
      "type": "structure",
      "members": {},
      "traits": { "smithy.api#error": "client" }
    },
    "com.example#AccessDenied": {
      "type": "structure",
      "members": {},
      "traits": { "smithy.api#error": "client" }
    },
    "com.example#PermissionInput": {
      "type": "structure",
      "members": {
        "action": { "target": "com.example#Action", "traits": { "smithy.api#httpLabel": {} } },
        "principal": { "target": "com.example#Principal" }
      }
    },
    "com.example#PermissionOutput": {
      "type": "structure",
      "members": {
        "action": { "target": "com.example#Action" }
      }
    },
    "com.example#Action": {
      "type": "enum",
      "members": {
        "READ": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "read" } }
      }
    },
    "com.example#Principal": {
      "type": "structure",
      "members": {}
    },
    "com.example#Taken": {
      "type": "enum",
      "members": {
        "YES": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "yes" } }
      }
    },
    "com.example#Moved": {
      "type": "enum",
      "members": {
        "YES": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "yes" } }
      }
    },
    "com.example#InputStream": {
      "type": "union",
      "members": {
        "chunk": { "target": "com.example#Chunk" }
      },
      "traits": { "smithy.api#streaming": {} }
    },
    "com.example#Chunk": {
      "type": "structure",
      "members": {}
    },
    "com.example#PutValue": {
      "type": "operation",
      "input": { "target": "com.example#PutValueRequest" }
    },
    "com.example#PutValueRequest": {
      "type": "structure",
      "members": {
        "value": { "target": "com.example#AttributeValue" },
        "spec": { "target": "com.example#SpotSpec" }
      }
    },
    "com.example#AttributeValue": {
      "type": "structure",
      "members": {
        "Value": { "target": "smithy.api#String" }
      }
    },
    "com.example#SpotSpec": {
      "type": "structure",
      "members": {
        "Kind": { "target": "smithy.api#String" }
      }
    },
    "com.example#Spec": {
      "type": "structure",
      "members": {
        "Kind": { "target": "smithy.api#String" },
        "Groups": { "target": "com.example#IdList" }
      }
    },
    "com.example#IdList": {
      "type": "list",
      "member": { "target": "smithy.api#String" }
    },
    "com.example#NameList": {
      "type": "list",
      "member": { "target": "smithy.api#String" }
    },
    "com.example#Dup": {
      "type": "structure",
      "members": {}
    },
    "com.other#Dup": {
      "type": "structure",
      "members": {}
    }
  }
}
