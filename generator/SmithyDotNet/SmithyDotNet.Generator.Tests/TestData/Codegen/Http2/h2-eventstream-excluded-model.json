{
  "smithy": "2.0",
  "shapes": {
    "com.example#Example": {
      "type": "service",
      "version": "2023-01-01",
      "operations": [{ "target": "com.example#Chat" }],
      "traits": {
        "aws.api#service": { "sdkId": "Example", "endpointPrefix": "example" },
        "aws.protocols#restJson1": { "http": ["h2", "http/1.1"], "eventStreamHttp": ["http/1.1"] },
        "smithy.api#title": "Example"
      }
    },
    "com.example#Chat": {
      "type": "operation",
      "input": { "target": "com.example#ChatInput" },
      "output": { "target": "com.example#ChatOutput" },
      "traits": { "smithy.api#http": { "uri": "/chat", "method": "POST" } }
    },
    "com.example#ChatInput": {
      "type": "structure",
      "members": { "stream": { "target": "com.example#Stream", "traits": { "smithy.api#httpPayload": {} } } }
    },
    "com.example#ChatOutput": {
      "type": "structure",
      "members": { "stream": { "target": "com.example#Stream", "traits": { "smithy.api#httpPayload": {} } } }
    },
    "com.example#Stream": {
      "type": "union",
      "members": { "data": { "target": "com.example#DataEvent" } },
      "traits": { "smithy.api#streaming": {} }
    },
    "com.example#DataEvent": {
      "type": "structure",
      "members": { "msg": { "target": "smithy.api#String" } }
    }
  }
}
