    },
    "com.example#ThrottlingException": {
      "type": "structure",
      "members": { "message": { "target": "smithy.api#String" } },
      "traits": { "smithy.api#error": "client" }
    },
    "com.example#ValidationException": {
      "type": "structure",
      "members": { "message": { "target": "smithy.api#String" } },
      "traits": { "smithy.api#error": "client" }
    }
  }
}
