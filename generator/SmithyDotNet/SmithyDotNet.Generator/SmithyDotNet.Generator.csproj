<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmithyDotNet.Generator</RootNamespace>
    <AssemblyName>SmithyDotNet.Generator</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- The default output dir for `dotnet run` / the launch profile. Its generated .cs files would
       otherwise be globbed into this project's own compilation. -->
  <ItemGroup>
    <Compile Remove="generated-output/**/*.cs" />
  </ItemGroup>

  <!-- Standalone runs (the model option) have no repo to read the default-configuration modes from, and the
       Core NuGet package does not ship the file, so the repo copy is embedded at build time. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../sdk/src/Core/sdk-default-configuration.json" LogicalName="SmithyDotNet.Generator.sdk-default-configuration.json" />
  </ItemGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>smithy-dotnet</ToolCommandName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Held at 5.0.0: 5.3.0 pulls an analyzer which is built against compiler 4.12 (and fails with .NET 8) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
  </ItemGroup>
</Project>
