<?xml version="1.0" encoding="utf-16"?>
<property-value-rules>
  <property-value-rule>
    <property>Amazon.IAMToolbox.Model.GetRequestAuthorizationDetailsRequest.AuthorizationId</property>
    <max>256</max>
    <pattern>^[0123456789abcdefghijklmnopqrstuvwxyz]+$</pattern>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.IAMToolbox.Model.GetRequestAuthorizationPolicyRequest.AuthorizationId</property>
    <max>256</max>
    <pattern>^[0123456789abcdefghijklmnopqrstuvwxyz]+$</pattern>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.IAMToolbox.Model.GetRequestAuthorizationPolicyRequest.PolicyUri</property>
    <min>1</min>
    <max>2048</max>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.IAMToolbox.Model.AttachedTo.Arn</property>
    <pattern>^arn:[^:]*:[^:]*:[^:]*:[^:]*:.*$</pattern>
  </property-value-rule>
</property-value-rules>