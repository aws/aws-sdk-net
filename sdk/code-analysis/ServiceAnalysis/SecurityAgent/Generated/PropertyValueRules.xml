<?xml version="1.0" encoding="utf-16"?>
<property-value-rules>
  <property-value-rule>
    <property>Amazon.SecurityAgent.Model.BatchDisassociateFindingIssueError.Message</property>
    <max>300</max>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.SecurityAgent.Model.BatchExportFindingError.Message</property>
    <max>300</max>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.SecurityAgent.Model.CaCertificateSource.InlinePem</property>
    <min>1</min>
    <max>8192</max>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.SecurityAgent.Model.JiraIntegrationInput.SiteUrl</property>
    <min>1</min>
    <max>512</max>
    <pattern>^https://[a-zA-Z0-9\-]+\.atlassian\.net$</pattern>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.SecurityAgent.Model.JiraProjectMetadata.ProjectName</property>
    <min>1</min>
    <max>255</max>
  </property-value-rule>
  <property-value-rule>
    <property>Amazon.SecurityAgent.Model.JiraProjectResource.ProjectName</property>
    <min>1</min>
    <max>255</max>
  </property-value-rule>
</property-value-rules>